  "items": [
    { "id": "g1-01", "week": 1, "topic": "être", "type": "choice", "q": "Je ___ étudiant.", "options": ["suis", "es", "est", "sont"], "answer": 0, "explain": "je suis: être with je." },
    { "id": "g1-02", "week": 1, "topic": "être", "type": "choice", "q": "Vous ___ canadien ?", "options": ["êtes", "sommes", "est", "es"], "answer": 0, "explain": "vous êtes." },
    { "id": "g1-03", "week": 1, "topic": "être", "type": "choice", "q": "Nous ___ au Nigeria.", "options": ["sont", "sommes", "êtes", "suis"], "answer": 1, "explain": "nous sommes." },
    { "id": "g1-04", "week": 1, "topic": "être", "type": "choice", "q": "Elles ___ à Montréal.", "options": ["est", "sommes", "sont", "êtes"], "answer": 2, "explain": "ils/elles sont." },
    { "id": "g1-05", "week": 1, "topic": "être", "type": "type", "q": "Tu ___ fatigué ? (être)", "answer": "es", "explain": "tu es. Note: tu es / il est sound the same." },
    { "id": "g1-06", "week": 1, "topic": "pronouns", "type": "choice", "q": "Talking to your boss, you say: ___ êtes très gentil.", "options": ["Tu", "Vous", "Il", "Nous"], "answer": 1, "explain": "Use vous for someone you don't know well or should be polite to, like a boss or the TCF examiner." },
    { "id": "g1-07", "week": 1, "topic": "pronouns", "type": "choice", "q": "Marie et Sophie → ___", "options": ["ils", "elle", "elles", "on"], "answer": 2, "explain": "Two women → elles. If there is even one man in the group → ils." },
    { "id": "g1-08", "week": 1, "topic": "pronouns", "type": "choice", "q": "Paul et Marie → ___", "options": ["elles", "ils", "il", "vous"], "answer": 1, "explain": "A mixed group takes the masculine: ils." },
    { "id": "g1-09", "week": 1, "topic": "numbers", "type": "type", "q": "Write the number 15 in French.", "answer": "quinze", "explain": "11 onze, 12 douze, 13 treize, 14 quatorze, 15 quinze, 16 seize." },
    { "id": "g1-10", "week": 1, "topic": "numbers", "type": "choice", "q": "dix-huit = ?", "options": ["16", "17", "18", "19"], "answer": 2, "explain": "dix-huit = 10 + 8." },
    { "id": "g1-11", "week": 1, "topic": "nationality", "type": "choice", "q": "Elle est ___. (Canadian)", "options": ["canadien", "canadienne", "canadiens", "canadiennes"], "answer": 1, "explain": "The adjective agrees with a feminine subject: canadien → canadienne." },
    { "id": "g1-12", "week": 1, "topic": "greetings", "type": "choice", "q": "It's 8 p.m. You arrive at a friend's dinner. You say:", "options": ["Bonjour", "Bonsoir", "Bonne nuit", "Salut, au revoir"], "answer": 1, "explain": "Bonsoir is used in the evening. Bonne nuit is only for going to bed." },

    { "id": "g2-01", "week": 2, "topic": "avoir", "type": "choice", "q": "J'___ deux enfants.", "options": ["ai", "as", "a", "ont"], "answer": 0, "explain": "j'ai: je becomes j' before a vowel." },
    { "id": "g2-02", "week": 2, "topic": "avoir", "type": "choice", "q": "Ils ___ une grande maison.", "options": ["avons", "avez", "ont", "sont"], "answer": 2, "explain": "ils ont (have). Don't confuse it with ils sont (are)." },
    { "id": "g2-03", "week": 2, "topic": "avoir", "type": "type", "q": "Nous ___ un chien. (avoir)", "answer": "avons", "explain": "nous avons." },
    { "id": "g2-04", "week": 2, "topic": "age", "type": "choice", "q": "I am 25 years old →", "options": ["Je suis 25 ans.", "J'ai 25 ans.", "J'ai 25 années.", "Je 25 ans."], "answer": 1, "explain": "French uses avoir for age: J'ai 25 ans." },
    { "id": "g2-05", "week": 2, "topic": "articles", "type": "choice", "q": "___ famille", "options": ["le", "la", "l'", "les"], "answer": 1, "explain": "famille is feminine → la famille." },
    { "id": "g2-06", "week": 2, "topic": "articles", "type": "choice", "q": "___ enfant", "options": ["le", "la", "l'", "un'"], "answer": 2, "explain": "le and la become l' before a vowel or silent h." },
    { "id": "g2-07", "week": 2, "topic": "articles", "type": "choice", "q": "J'ai ___ sœur et ___ frère.", "options": ["un / une", "une / un", "une / une", "la / le"], "answer": 1, "explain": "sœur is feminine (une), frère is masculine (un)." },
    { "id": "g2-08", "week": 2, "topic": "articles", "type": "choice", "q": "Je suis ___ médecin.", "options": ["un", "le", "(nothing)", "une"], "answer": 2, "explain": "No article with a job after être: Je suis médecin. But: C'est un médecin." },
    { "id": "g2-09", "week": 2, "topic": "plural", "type": "choice", "q": "un enfant → ___ enfants", "options": ["les", "des", "de", "un"], "answer": 1, "explain": "un/une → des in the plural." },
    { "id": "g2-10", "week": 2, "topic": "possessives", "type": "choice", "q": "___ mère (my)", "options": ["mon", "ma", "mes", "me"], "answer": 1, "explain": "mère is feminine → ma." },
    { "id": "g2-11", "week": 2, "topic": "possessives", "type": "choice", "q": "___ amie (my)", "options": ["ma", "mon", "mes", "m'"], "answer": 1, "explain": "Before a vowel, even a feminine noun takes mon: mon amie." },
    { "id": "g2-12", "week": 2, "topic": "possessives", "type": "choice", "q": "___ parents (my)", "options": ["mon", "ma", "mes", "mis"], "answer": 2, "explain": "Plural → mes." },

    { "id": "g3-01", "week": 3, "topic": "-er verbs", "type": "type", "q": "Je ___ français. (parler)", "answer": "parle", "explain": "-er verbs: je parle, tu parles, il parle, nous parlons, vous parlez, ils parlent." },
    { "id": "g3-02", "week": 3, "topic": "-er verbs", "type": "type", "q": "Nous ___ la télé. (regarder)", "answer": "regardons", "explain": "nous → -ons." },
    { "id": "g3-03", "week": 3, "topic": "-er verbs", "type": "type", "q": "Vous ___ à Lagos ? (habiter)", "answer": "habitez", "explain": "vous → -ez." },
    { "id": "g3-04", "week": 3, "topic": "-er verbs", "type": "type", "q": "Ils ___ beaucoup. (travailler)", "answer": "travaillent", "explain": "ils → -ent, which is silent: travaillent sounds like travaille." },
    { "id": "g3-05", "week": 3, "topic": "-er verbs", "type": "choice", "q": "Nous ___ à midi. (manger)", "options": ["mangons", "mangeons", "mangeont", "mangez"], "answer": 1, "explain": "Verbs ending in -ger keep the e before -ons: nous mangeons." },
    { "id": "g3-06", "week": 3, "topic": "-er verbs", "type": "choice", "q": "Tu ___ le thé ? (aimer)", "options": ["aime", "aimes", "aimez", "aiment"], "answer": 1, "explain": "tu → -es." },
    { "id": "g3-07", "week": 3, "topic": "negation", "type": "choice", "q": "Make it negative: Je travaille le dimanche.", "options": ["Je ne travaille le dimanche pas.", "Je ne travaille pas le dimanche.", "Je pas travaille le dimanche.", "Ne je travaille pas le dimanche."], "answer": 1, "explain": "ne + verb + pas." },
    { "id": "g3-08", "week": 3, "topic": "negation", "type": "choice", "q": "Make it negative: J'aime le café.", "options": ["Je n'aime pas le café.", "Je ne aime pas le café.", "J'aime pas ne le café.", "Je n'aime le café pas."], "answer": 0, "explain": "ne becomes n' before a vowel: je n'aime pas." },
    { "id": "g3-09", "week": 3, "topic": "negation", "type": "choice", "q": "Il ne regarde ___ la télé. (never)", "options": ["pas", "jamais", "rien", "plus"], "answer": 1, "explain": "ne … jamais = never." },
    { "id": "g3-10", "week": 3, "topic": "reflexive", "type": "choice", "q": "Je ___ lève à six heures.", "options": ["se", "me", "te", "le"], "answer": 1, "explain": "Reflexive verbs: je me lève, tu te lèves, il se lève." },
    { "id": "g3-11", "week": 3, "topic": "time", "type": "choice", "q": "7:30 →", "options": ["sept heures et quart", "sept heures et demie", "sept heures trente minutes moins", "huit heures moins le quart"], "answer": 1, "explain": "et demie = half past." },
    { "id": "g3-12", "week": 3, "topic": "days", "type": "choice", "q": "I work on Mondays (every Monday) →", "options": ["Je travaille lundi.", "Je travaille le lundi.", "Je travaille en lundi.", "Je travaille à lundi."], "answer": 1, "explain": "le lundi = every Monday. lundi alone = this Monday." },

    { "id": "g4-01", "week": 4, "topic": "aller", "type": "choice", "q": "Je ___ à la banque.", "options": ["va", "vais", "vas", "allons"], "answer": 1, "explain": "aller: je vais, tu vas, il va, nous allons, vous allez, ils vont." },
    { "id": "g4-02", "week": 4, "topic": "aller", "type": "type", "q": "Ils ___ au Canada l'année prochaine. (aller)", "answer": "vont", "explain": "ils vont." },
    { "id": "g4-03", "week": 4, "topic": "à + article", "type": "choice", "q": "Je vais ___ marché.", "options": ["à le", "au", "à la", "aux"], "answer": 1, "explain": "à + le = au." },
    { "id": "g4-04", "week": 4, "topic": "à + article", "type": "choice", "q": "Nous allons ___ États-Unis.", "options": ["à les", "au", "aux", "en"], "answer": 2, "explain": "à + les = aux." },
    { "id": "g4-05", "week": 4, "topic": "countries", "type": "choice", "q": "J'habite ___ Canada.", "options": ["en", "au", "à", "dans"], "answer": 1, "explain": "Masculine countries take au (au Canada, au Nigeria); feminine ones take en (en France)." },
    { "id": "g4-06", "week": 4, "topic": "countries", "type": "choice", "q": "Elle travaille ___ France.", "options": ["au", "à la", "en", "à"], "answer": 2, "explain": "Feminine countries take en: en France, en Angleterre." },
    { "id": "g4-07", "week": 4, "topic": "cities", "type": "choice", "q": "Je vis ___ Toronto.", "options": ["à", "au", "en", "dans"], "answer": 0, "explain": "Cities take à: à Lagos, à Montréal." },
    { "id": "g4-08", "week": 4, "topic": "questions", "type": "choice", "q": "___ tu habites ? – À Ikeja.", "options": ["Quand", "Où", "Pourquoi", "Qui"], "answer": 1, "explain": "où = where." },
    { "id": "g4-09", "week": 4, "topic": "questions", "type": "choice", "q": "Formal question: 'Do you speak English?'", "options": ["Vous parlez anglais ?", "Est-ce que vous parlez anglais ?", "Parlez-vous anglais ?", "All three are correct"], "answer": 3, "explain": "Intonation, est-ce que and inversion are all correct. Inversion is the most formal." },
    { "id": "g4-10", "week": 4, "topic": "faire", "type": "type", "q": "Qu'est-ce que vous ___ ce week-end ? (faire)", "answer": "faites", "explain": "vous faites is irregular. Never write 'vous faisez'." },
    { "id": "g4-11", "week": 4, "topic": "futur proche", "type": "choice", "q": "Tomorrow I am going to visit Montréal →", "options": ["Demain, je visite Montréal va.", "Demain, je vais visiter Montréal.", "Demain, je vais visite Montréal.", "Demain, je aller visiter Montréal."], "answer": 1, "explain": "futur proche = aller (conjugated) + infinitive." },
    { "id": "g4-12", "week": 4, "topic": "prepositions", "type": "choice", "q": "La pharmacie est ___ la banque. (next to)", "options": ["à côté de", "en face", "loin", "entre"], "answer": 0, "explain": "à côté de = next to." },

    { "id": "g5-01", "week": 5, "topic": "partitive", "type": "choice", "q": "Je mange ___ pain.", "options": ["le", "du", "de la", "des"], "answer": 1, "explain": "Use the partitive for an unspecified amount: du (m.), de la (f.), de l' (before a vowel), des (pl.)." },
    { "id": "g5-02", "week": 5, "topic": "partitive", "type": "choice", "q": "Tu veux ___ eau ?", "options": ["du", "de la", "de l'", "des"], "answer": 2, "explain": "eau starts with a vowel → de l'eau." },
    { "id": "g5-03", "week": 5, "topic": "partitive", "type": "choice", "q": "Je ne mange pas ___ viande.", "options": ["de la", "du", "de", "la"], "answer": 2, "explain": "After a negation, du/de la/des → de (d')." },
    { "id": "g5-04", "week": 5, "topic": "partitive", "type": "choice", "q": "J'aime ___ fromage.", "options": ["du", "le", "de", "des"], "answer": 1, "explain": "After aimer/adorer/détester, use the definite article (le/la/les) because you mean it in general." },
    { "id": "g5-05", "week": 5, "topic": "quantities", "type": "choice", "q": "un kilo ___ tomates", "options": ["des", "de", "du", "les"], "answer": 1, "explain": "After a quantity, use de: un kilo de, beaucoup de, une bouteille d'eau." },
    { "id": "g5-06", "week": 5, "topic": "adjectives", "type": "choice", "q": "une ___ maison (small)", "options": ["petit", "petite", "petits", "petites"], "answer": 1, "explain": "Adjectives agree with the noun: petit → petite." },
    { "id": "g5-07", "week": 5, "topic": "adjectives", "type": "choice", "q": "Where does 'rouge' go? → une ___ voiture ___", "options": ["rouge / (nothing)", "(nothing) / rouge", "both are fine", "rouges / rouge"], "answer": 1, "explain": "Most adjectives go after the noun. Short common ones (BAGS: beauty, age, goodness, size) go before." },
    { "id": "g5-08", "week": 5, "topic": "numbers", "type": "type", "q": "Write 80 in French.", "answer": "quatre-vingts", "accept": ["quatre vingts"], "explain": "80 = quatre-vingts (four twenties). The s drops when a number follows: quatre-vingt-un." },
    { "id": "g5-09", "week": 5, "topic": "numbers", "type": "choice", "q": "soixante-quinze = ?", "options": ["65", "75", "85", "95"], "answer": 1, "explain": "soixante-quinze = 60 + 15." },
    { "id": "g5-10", "week": 5, "topic": "politeness", "type": "choice", "q": "Polite way to order in a shop:", "options": ["Je veux un pain.", "Je voudrais une baguette, s'il vous plaît.", "Donne-moi une baguette.", "Baguette !"], "answer": 1, "explain": "je voudrais (conditional) is the polite 'I would like'." },
    { "id": "g5-11", "week": 5, "topic": "acheter", "type": "type", "q": "Nous ___ des fruits au marché. (acheter)", "answer": "achetons", "explain": "acheter: j'achète, nous achetons (no accent with -ons)." },
    { "id": "g5-12", "week": 5, "topic": "payer", "type": "choice", "q": "Vous ___ par carte ? (payer)", "options": ["payez", "payons", "paie", "payent"], "answer": 0, "explain": "vous payez." },

    { "id": "g6-01", "week": 6, "topic": "pouvoir", "type": "choice", "q": "Est-ce que je ___ entrer ?", "options": ["peux", "peut", "pouvons", "peuvent"], "answer": 0, "explain": "pouvoir: je peux, tu peux, il peut, nous pouvons, vous pouvez, ils peuvent." },
    { "id": "g6-02", "week": 6, "topic": "vouloir", "type": "type", "q": "Ils ___ partir au Canada. (vouloir)", "answer": "veulent", "explain": "ils veulent." },
    { "id": "g6-03", "week": 6, "topic": "devoir", "type": "type", "q": "Vous ___ remplir ce formulaire. (devoir)", "answer": "devez", "explain": "vous devez." },
    { "id": "g6-04", "week": 6, "topic": "modal + infinitive", "type": "choice", "q": "Je dois ___ demain.", "options": ["travaille", "travailler", "travaillé", "travaillez"], "answer": 1, "explain": "After pouvoir/vouloir/devoir, the next verb stays in the infinitive." },
    { "id": "g6-05", "week": 6, "topic": "weather", "type": "choice", "q": "It's cold →", "options": ["Il est froid.", "Il fait froid.", "C'est froid temps.", "Il a froid."], "answer": 1, "explain": "Weather uses il fait. Il a froid = he feels cold." },
    { "id": "g6-06", "week": 6, "topic": "-ir verbs", "type": "type", "q": "Je ___ à 17 h. (finir)", "answer": "finis", "explain": "-ir (2nd group): je finis, nous finissons, ils finissent." },
    { "id": "g6-07", "week": 6, "topic": "-ir verbs", "type": "type", "q": "Nous ___ le menu. (choisir)", "answer": "choisissons", "explain": "nous choisissons (-issons)." },
    { "id": "g6-08", "week": 6, "topic": "venir", "type": "choice", "q": "Tu ___ avec nous ?", "options": ["viens", "vient", "venez", "viennent"], "answer": 0, "explain": "venir: je viens, tu viens, il vient, nous venons, vous venez, ils viennent." },
    { "id": "g6-09", "week": 6, "topic": "invitations", "type": "choice", "q": "Refuse politely:", "options": ["Non.", "Je ne veux pas.", "Merci, c'est gentil, mais je ne peux pas samedi.", "Pas possible pour toi."], "answer": 2, "explain": "Thank, then give the reason: c'est gentil, mais je ne peux pas." },
    { "id": "g6-10", "week": 6, "topic": "il faut", "type": "choice", "q": "___ réserver avant de venir.", "options": ["Il faut", "Il faire", "Il faux", "Il fait"], "answer": 0, "explain": "il faut + infinitive = one must / it's necessary. Don't confuse it with faux (false) or fait (from faire)." },
    { "id": "g6-11", "week": 6, "topic": "seasons", "type": "choice", "q": "___ hiver, il neige.", "options": ["Au", "En", "À la", "Dans le"], "answer": 1, "explain": "en été, en automne, en hiver, but au printemps." },
    { "id": "g6-12", "week": 6, "topic": "sortir", "type": "type", "q": "Vous ___ ce soir ? (sortir)", "answer": "sortez", "explain": "sortir: je sors, nous sortons, vous sortez." },

    { "id": "g7-01", "week": 7, "topic": "passé composé (avoir)", "type": "choice", "q": "Hier, j'___ un film.", "options": ["ai regardé", "suis regardé", "ai regarder", "regardé"], "answer": 0, "explain": "passé composé = avoir/être in the present + past participle. regarder → regardé." },
    { "id": "g7-02", "week": 7, "topic": "passé composé (avoir)", "type": "type", "q": "Nous avons ___ au restaurant. (manger)", "answer": "mangé", "explain": "-er verbs → -é." },
    { "id": "g7-03", "week": 7, "topic": "passé composé (avoir)", "type": "type", "q": "Tu as ___ ton travail ? (finir)", "answer": "fini", "explain": "-ir verbs → -i." },
    { "id": "g7-04", "week": 7, "topic": "irregular participles", "type": "choice", "q": "J'ai ___ le bus. (prendre)", "options": ["prendu", "pris", "prit", "prené"], "answer": 1, "explain": "prendre → pris. Other key ones: faire → fait, avoir → eu, être → été, voir → vu." },
    { "id": "g7-05", "week": 7, "topic": "irregular participles", "type": "choice", "q": "Qu'est-ce que tu as ___ ce week-end ? (faire)", "options": ["fais", "faire", "fait", "faisé"], "answer": 2, "explain": "faire → fait." },
    { "id": "g7-06", "week": 7, "topic": "negation in past", "type": "choice", "q": "Negative: J'ai mangé.", "options": ["Je n'ai mangé pas.", "Je n'ai pas mangé.", "Je ne pas ai mangé.", "Je n'ai pas manger."], "answer": 1, "explain": "ne … pas goes around the auxiliary: je n'ai pas mangé." },
    { "id": "g7-07", "week": 7, "topic": "passé composé (avoir)", "type": "type", "q": "Ils ont ___ une maison. (acheter)", "answer": "acheté", "explain": "acheter → acheté." },
    { "id": "g7-08", "week": 7, "topic": "irregular participles", "type": "type", "q": "J'ai ___ tes messages. (voir)", "answer": "vu", "explain": "voir → vu." },
    { "id": "g7-09", "week": 7, "topic": "time markers", "type": "choice", "q": "Which one signals the past?", "options": ["demain", "la semaine dernière", "la semaine prochaine", "bientôt"], "answer": 1, "explain": "dernier/dernière = last. prochain = next." },
    { "id": "g7-10", "week": 7, "topic": "passé composé (avoir)", "type": "type", "q": "Vous avez ___ le formulaire ? (lire)", "answer": "lu", "explain": "lire → lu." },

    { "id": "g8-01", "week": 8, "topic": "passé composé (être)", "type": "choice", "q": "Elle ___ allée à Paris.", "options": ["a", "est", "était", "ai"], "answer": 1, "explain": "Movement verbs (aller, venir, partir, arriver, entrer, sortir, naître, mourir…) take être." },
    { "id": "g8-02", "week": 8, "topic": "agreement", "type": "choice", "q": "Elles sont ___ hier.", "options": ["arrivé", "arrivée", "arrivés", "arrivées"], "answer": 3, "explain": "With être, the participle agrees with the subject: elles → -ées." },
    { "id": "g8-03", "week": 8, "topic": "passé composé (être)", "type": "type", "q": "Je suis ___ au Canada l'année dernière. (venir)", "answer": "venu", "accept": ["venue"], "explain": "venir → venu (venue if the speaker is a woman)." },
    { "id": "g8-04", "week": 8, "topic": "avoir or être", "type": "choice", "q": "Nous ___ partis tôt.", "options": ["avons", "sommes", "êtes", "ont"], "answer": 1, "explain": "partir takes être." },
    { "id": "g8-05", "week": 8, "topic": "avoir or être", "type": "choice", "q": "Il ___ travaillé toute la journée.", "options": ["est", "a", "ai", "sont"], "answer": 1, "explain": "Most verbs take avoir. Only movement/change-of-state verbs and reflexives take être." },
    { "id": "g8-06", "week": 8, "topic": "reflexive past", "type": "choice", "q": "Je ___ levé à 6 h.", "options": ["m'ai", "me suis", "suis", "me a"], "answer": 1, "explain": "Reflexive verbs always take être: je me suis levé(e)." },
    { "id": "g8-07", "week": 8, "topic": "irregular participles", "type": "type", "q": "Il est ___ en 1990. (naître)", "answer": "né", "explain": "naître → né. il est né = he was born." },
    { "id": "g8-08", "week": 8, "topic": "agreement", "type": "choice", "q": "Marie : « Je suis ___ tard. »", "options": ["rentré", "rentrée", "rentrés", "rentrer"], "answer": 1, "explain": "A woman speaking → rentrée." },
